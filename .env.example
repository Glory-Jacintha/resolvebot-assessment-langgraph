# Copy this file to .env and fill in your key. Never commit .env.

# --- Data (defaults point at ./data) ---
POLICIES_PATH=./data/policies.md
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/shopsphere.db

# The date the assistant treats as "today" (the computer clock is never used for this)
APP_TODAY=2026-07-01

# --- LLM ---
# anthropic | openai | gemini
LLM_PROVIDER=anthropic
# Leave empty to use the provider's default model
LLM_MODEL=

# Set the key for the provider you chose
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: point the "openai" provider at a local OpenAI-compatible server
OPENAI_BASE_URL=

# --- Limits ---
MAX_TOOL_CALLS=6
LLM_TIMEOUT_SECONDS=20
# Total time budget for one /chat reply (the task allows 30 s)
REPLY_TIME_BUDGET_SECONDS=26
